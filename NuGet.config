<?xml version="1.0" encoding="utf-8"?>
<!--
  Rulealize.Abstraction is not on nuget.org yet, so it is consumed from a folder
  feed produced by `dotnet pack` in the Rulealize.Abstraction repository. Delete
  this file once the package is published.
-->
<configuration>
  <packageSources>
    <add key="rulealize-local" value="..\LocalNuGet" />
  </packageSources>
</configuration>
