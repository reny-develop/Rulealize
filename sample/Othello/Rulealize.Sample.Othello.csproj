<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Rulealize.Sample.Othello</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rulealize.csproj" />
  </ItemGroup>

  <!--
    Builds the ten standard plugins and drops their DLLs into a plugins folder beside the
    executable. The reference is not a compile-time one, so this program cannot name a
    plugin type; it finds them the way any host does, by scanning the folder.
  -->
  <Import Project="..\..\StandardPlugins.props" />

  <ItemGroup>
    <Content Include="RuleSets\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
