<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\Rulealize.csproj" />

    <!--
      deploy.json is written against a vocabulary that is not a plugin assembly and never
      will be: it is a class in the Deploy sample, handed to a runtime with AddPlugin. A
      compile-time reference is exactly right here and would be wrong for the standard
      plugins — the whole point of an in-process vocabulary is that the host names its type.
    -->
    <ProjectReference Include="..\sample\Deploy\Rulealize.Sample.Deploy.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The sample's policy documents, so the reader that parses them is exercised too. -->
    <Content Include="..\sample\Deploy\Policy\*.json" Link="Policy\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />

    <!--
      The quick guide, because it prints a rule set document in full and a printed copy is
      the one thing here that nothing else could hold down. The README's copy of approval.json
      drifted from the document exactly this way — its `requires` lost an entry, and the
      document went on compiling, so nothing said a word. CountdownTests parses the block out
      of this file and compares it to ruleset/countdown.json.
    -->
    <Content Include="..\doc\ruleset-quickguide.md" Link="Doc\ruleset-quickguide.md"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Builds the standard plugins and drops their DLLs into a plugin folder. -->
  <Import Project="..\Plugins.props" />

  <!-- Every rule set the repository ships. A document nothing here compiles is a document
       that is only claimed to work. -->
  <ItemGroup>
    <RulealizeRuleSet Include="approval" />
    <RulealizeRuleSet Include="countdown" />
    <RulealizeRuleSet Include="reversi" />
    <RulealizeRuleSet Include="chess" />
    <RulealizeRuleSet Include="shogi" />
    <RulealizeRuleSet Include="roster" />
    <RulealizeRuleSet Include="blackjack" />
    <RulealizeRuleSet Include="blackjack-choice" />
    <RulealizeRuleSet Include="deploy" />
    <RulealizeRuleSet Include="kitchen-sink" />
  </ItemGroup>

  <Import Project="..\RuleSets.props" />

</Project>
